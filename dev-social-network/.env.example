# ============================================================

# Copia este archivo a `.env` y pon tus credenciales reales.
#   cp .env.example .env
# ============================================================

DB_USERNAME=codefactory
DB_PASSWORD=codefactory
DB_DATABASE=codefactory

# Puerto del host donde se publica el contenedor de Postgres.
# compose.yaml usa ${DB_PORT:-5432}
DB_HOST=localhost
DB_PORT=5432

POSTGRES_DB=codefactory
POSTGRES_USER=codefactory
POSTGRES_PASSWORD=codefactory

APP_JWT_SECRET=

# Puerto de la aplicación. Usa 8080 si está libre.
SERVER_PORT=8080

# ============================================================
# SonarQube  (docker compose --profile sonar up -d)
# Solo se usan si vas a analizar el código con sonar:sonar.
# ============================================================
SONAR_PORT=9000
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar